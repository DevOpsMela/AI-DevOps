      "versionNonce": 442251100,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780059260028,
      "link": null,
      "locked": false,
      "text": "Learning: Through repeated interactions, the dog\nlearns that bringing the ball back leads to\npositive reinforcement (the treat) and is more\nlikely to repeat the desired behavior in the\nfuture.",
      "fontSize": 47.27056226046613,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Learning: Through repeated interactions, the dog learns that bringing the ball back leads to positive reinforcement (the treat) and is more likely to repeat the desired behavior in the future.",
      "autoResize": false,
      "lineHeight": 1.25
    },

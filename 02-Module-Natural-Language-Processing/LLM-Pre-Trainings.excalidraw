      "link": null,
      "locked": false,
      "text": "Reward: The dog receives a treat or praise when it\nsuccessfully brings the ball back.​",
      "fontSize": 47.27056226046613,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reward: The dog receives a treat or praise when it successfully brings the ball back.​",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eoZZ_xg8LVpKw1nMYZtHy",
      "type": "text",
      "x": 3315.0786297440636,
      "y": 10488.238394107766,
      "width": 1247.9423490763938,
